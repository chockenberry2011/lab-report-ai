{
  "name": "lab-ai-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lab AI React Frontend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit || true",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix",
    "lint:strict": "eslint --ext .ts,.tsx src/pages/review src/pages",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "depgraph": "madge --circular --extensions ts,tsx src",
    "analyze:cycles": "madge --circular --extensions ts,tsx,js src && echo 'No circular deps 👍'",
    "diag:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "check:lock": "bash ./scripts/check-lock.sh",
    "check:scripts": "node -e \"const s=require('./package.json').scripts||{}; if(!s.build){console.error('Missing build script'); process.exit(1)}; console.log('OK build script present')\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.8.4",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.292.0",
    "pdfjs-dist": "5.3.93",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-highlight-words": "^0.20.0",
    "react-hot-toast": "^2.4.1",
    "react-json-tree": "^0.18.0",
    "react-pdf": "^10.1.0",
    "react-router-dom": "^6.20.1",
    "react-virtualized": "^9.22.5",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-virtualized": "^9.21.29",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "madge": "^6.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "overrides": {
    "pdfjs-dist": "5.3.93"
  }
}
