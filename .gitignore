# Lab AI - Comprehensive .gitignore

# ============================================================================
# Data & Models (Large files - not suitable for Git)
# ============================================================================
/data/
/models/
!data/README.md
!data/.gitkeep
!models/.gitkeep

# ============================================================================
# Environment & Secrets
# ============================================================================
.env
.env.local
.env.*.local
*.env
!.env.example

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# Python testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
nosetests.xml

# ============================================================================
# JavaScript / Node.js
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Testing
coverage/
*.lcov

# Production builds
dist/
build/

# Next.js
.next/
out/

# Vite
.vite/

# Package manager locks (keep package-lock.json for reproducibility)
# Uncomment if you want to exclude:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================================================
# Docker & Containers
# ============================================================================
*.log
docker-compose.override.yml

# Docker volumes
volumes/

# ============================================================================
# Operating System
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.directory
.Trash-*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# ============================================================================
# IDEs & Editors
# ============================================================================
.vscode/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# ============================================================================
# Development Artifacts
# ============================================================================
*.bak
*.bak.*
*.patch
*.orig
*.rej
.~*

# Temporary files
tmp/
temp/
*.tmp

# ============================================================================
# Label Studio
# ============================================================================
/data/labelstudio/

# ============================================================================
# Jupyter Notebooks
# ============================================================================
.ipynb_checkpoints/
*.ipynb

# ============================================================================
# Airflow
# ============================================================================
airflow.db
airflow.cfg
logs/
unittests.cfg

# ============================================================================
# Redis
# ============================================================================
dump.rdb

# ============================================================================
# Project Specific
# ============================================================================
# Development/debugging outputs
*.debug.json

# Training exports
exports/

# Job tracking
jobs.json

# Evaluation results
evaluation/

# Celery
celerybeat-schedule
celerybeat.pid

# Documentation build artifacts
docs/_build/
site/
